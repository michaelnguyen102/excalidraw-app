rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /diagrams/{diagramId} {
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      // allow list via query where ownerId == uid (requires index)
      allow list: if request.auth != null;
    }
    // legacy: keep open for collab/shareLinks if needed — tighten later
    match /{document=**} {
      allow get, write: if true;
      allow list: if false;
    }
  }
}
